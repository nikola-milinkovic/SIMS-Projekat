<o:Shortcut Ref="o73"/>
</c:AttachedRequirements>
</o:UseCase>
<o:UseCase Id="o144">
<a:ObjectID>553F003E-1204-4520-B5F5-F22B38D1AE54</a:ObjectID>
<a:Name>Istorija servisa</a:Name>
<a:Code>UC-08</a:Code>
<a:CreationDate>1789495835</a:CreationDate>
<a:Creator>nikol</a:Creator>
<a:ModificationDate>1789495835</a:ModificationDate>
<a:Modifier>nikol</a:Modifier>
<a:GlobalObjectID/>
<a:Step>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\widctlpar\f0\fs20 1. Me\f1\lang6170 h\f0\lang1033 ani\f1\lang6170\&#39;e8\f0\lang1033 ar postavlja status na COMPLETED\par
2. Sistem automatski kreira zapis u istoriji servisa\par
3. Zapis sadr\f1\lang6170\&#39;9e\f0\lang1033 i datum, opis radova, mehani\f1\lang6170\&#39;e8\f0\lang1033 ara i tro\f1\lang6170\&#39;9a\f0\lang1033 kove\par

\pard 4. Korisnik mo\f1\lang6170\&#39;9e\f0\lang1033 e u svakom trenutku pregledati istoriju svog vozila\fs20\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Otkazana rezervacija - zapis se ne kreira ili se bilje\&#39;9ei kao CANCELLED\par
2. Pregled istorije nepostoje\&#39;e6eg vozila - odgovaraju\&#39;e6a poruka\f1\lang1033\par
}
</a:UseCase.Extension>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Korisnik je prijavljen na sistem\par
2. Vozilo je evidentirano u sistemu\f1\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 Servisni zapis je trajno sa\&#39;e8uvan i dostupan je korisniku kroz pregled vozila\f1\lang1033\par
}
</a:PostCondition>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20 Sistem mora trajno \f1\lang6170\&#39;e8u\f0\lang1033 vati evidenciju svih izvr\f1\lang6170\&#39;9a\f0\lang1033 enih servisa za svako vozilo, omogu\f1\lang6170\&#39;e6\f0\lang1033 avaju\f1\lang6170\&#39;e6\f0\lang1033 i korisniku pregled kompletne istorije popravki i tro\f1\lang6170\&#39;9a\f0\lang1033 kova\fs20\par
}
</a:Description>
</o:UseCase>
<o:UseCase Id="o143">
<a:ObjectID>37131608-A4FF-4FA0-A5DE-65A8AB077DAA</a:ObjectID>
<a:Name>Praćenje statusa servisa</a:Name>
<a:Code>UC-09</a:Code>
<a:CreationDate>1789495835</a:CreationDate>
<a:Creator>nikol</a:Creator>
<a:ModificationDate>1789495835</a:ModificationDate>
<a:Modifier>nikol</a:Modifier>
<a:GlobalObjectID/>
<a:Step>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\widctlpar\f0\fs20 1. Me\f1\lang6170 h\f0\lang1033 ani\f1\lang6170\&#39;e8\f0\lang1033 ar se prijavljuje i otvara listu svojih radnih naloga\par
2. Me\f1\lang6170 h\f0\lang1033 ani\f1\lang6170\&#39;e8\f0\lang1033 ar otvara konkretan radni nalog\par
3. Me\f1\lang6170 h\f0\lang1033 ani\f1\lang6170\&#39;e8\f0\lang1033 ar mijenja status servisiranja\par
4. Me\f1\lang6170 h\f0\lang1033 ani\f1\lang6170\&#39;e8\f0\lang1033 ar moze dodati napomenu uz promjenu\par

\pard 5. Sistem \f1\lang6170\&#39;e8u\f0\lang1033 va promjenu i \f1\lang6170\&#39;9a\f0\lang1033 alje \f1\lang6170 obavje\&#39;9atenje\f0\lang1033  korisniku\fs20\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2 Times New Roman;}{\f1\froman\fprq2\fcharset238 Times New Roman;}{\f2\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Poku\&#39;9aaj promjene statusa servisa koji je \f1 statusa COMPLETED - prikaz odgovaraju\&#39;e6e poruke\par
2. Korisnik nema ovla\&#39;9a\&#39;e6enja - prikaz odgovaraju\&#39;e6e poruke\f2\lang1033\par
}
</a:UseCase.Extension>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Korisnik je prijavljen na sistem\par
2. Servisni nalog postoji\par
3. Vozilo je evidentirano u sistemu \f1\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Status servisa je a\&#39;9euriran i korisnik je obavije\&#39;9aten o promjeni\f1\lang1033\par
}
</a:PostCondition>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20 Sistem mora omogu\f1\lang6170\&#39;e6\f0\lang1033 iti mehani\f1\lang6170\&#39;e8\f0\lang1033 aru a\f1\lang6170\&#39;9e\f0\lang1033 uriranje statusa radnog naloga tokom servisiranja, a korisniku pregled trenutnog stanja svog vozila u realnom vremenu.\fs20\par
}
</a:Description>
<c:AttachedRequirements>
<o:Shortcut Ref="o75"/>
</c:AttachedRequirements>
</o:UseCase>
<o:UseCase Id="o142">
<a:ObjectID>EA87B990-64DB-4765-AE11-69A78DC9CA0F</a:ObjectID>
<a:Name>Dodjela mehaničara</a:Name>
<a:Code>UC-07</a:Code>
<a:CreationDate>1789495835</a:CreationDate>
<a:Creator>nikol</a:Creator>
<a:ModificationDate>1789495835</a:ModificationDate>
<a:Modifier>nikol</a:Modifier>
<a:GlobalObjectID/>
<a:Step>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\widctlpar\f0\fs20\lang6170 1. Menad\&#39;9eer\f1\lang1033  \f0\lang6170 pregleda raspored rezervacija\f1\lang1033\par
2. \f0\lang6170 Menad\&#39;9eer\f1\lang1033  \f0\lang6170 filtrira rezervacije koje \&#39;e8ekaju dodjelu mehani\&#39;e8ara\f1\lang1033\par
\f0\lang6170 3. Sistem prikazuje listu slobodnih mehani\&#39;e8ara za taj termin\f1\lang1033\par
\f0\lang6170 4. Menad\&#39;9eer vrsi odabir i dodjeljuje mehani\&#39;e8ara\f1\lang1033\par
\f0\lang6170 5. Sistem kreira radni nalog (WorkOrder)\f1\lang1033\par

\pard\f0\lang6170 6. Mehani\&#39;e8ar prima obavje\&#39;9atenje o dodjeli servisa\f1\lang1033\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\widctlpar\f0\fs20\lang6170 1. Svi mehani\&#39;e8ari su zauzeti - odgovaraju\&#39;e6a poruka\f1\lang1033\par

\pard\f0\lang6170 2. Poku\&#39;9aaj dodjele zauzetog mehani\&#39;e8ara - odgovaraju\&#39;e6a poruka, prikaz rasporeda tog mehani\&#39;e8ara\f1\lang1033\par
}
</a:UseCase.Extension>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Korisnik je prijavljen na sistem kao menad\&#39;9eer\par
2.  Kreiran je servisni termin \par
3. Vozilo je evidentirano u sistemu\par
\f1\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 1. Mehani\&#39;e8ar je dodijeljen servisu i kreiran je radni nalog\f1\lang1033\par
}
</a:PostCondition>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil Times New Roman;}}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang6170 Sistem mora omogu\&#39;e6iti menad\&#39;9eeru pregled rasporeda i dodjelu dostupnog mehani\&#39;e8ara na potvrdjenu rezervaciju, nakon \&#39;e8ega se kreira radni nalog\f1\lang1033\par
}
</a:Description>
<c:AttachedRequirements>
<o:Shortcut Ref="o74"/>
</c:AttachedRequirements>
</o:UseCase>
<o:UseCase Id="o162">
<a:ObjectID>77ADB42D-06C6-4DA3-BCA2-8E4BAA62D457</a:ObjectID>
<a:Name>Spriječavanje duplih rezervacija</a:Name>
<a:Code>UC-06</a:Code>
<a:CreationDate>1789495901</a:CreationDate>
<a:Creator>nikol</a:Creator>
<a:ModificationDate>1789495901</a:ModificationDate>
<a:Modifier>nikol</a:Modifier>
<a:GlobalObjectID/>
<a:Step>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.Korisnik odabira termin (tok FR-04).\par
2.Sistem provjerava postoji li aktivna rezervacija za isti termin.\par
3.Ako je termin slobodan , rezervacija se kreira.\par
4.Ako je termin zauzet, sistem odbija zahtjev i nudi alternative.\par
5. Baza podataka ima UNIQUE constraint kao dodatnu za\&#39;9atitu.\f1\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1. Istovremeni zahtjevi dva korisnika , transakcijsko zaklju\&#39;e8avanje daje predost prvom.\par
2.Direktni API zahtjevi , backend validacija odbija duplikat.\f1\par
}
</a:UseCase.Extension>
<a:PreCondition>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.\f1 Korisnik je odabrao termin iz liste slobodnih termina (FR-05).\par
\f0 2.\f1 Termin postoji u sistemu kao slobodan.\par
\f0 3.\f1 Rezervacija jo\f0\&#39;9a\f1  nije potvrdj\f0 e\f1 na.\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 Sistem garantuje jedinsvenost svakog termina u rasporedu.\f1\par
}
</a:PostCondition>
<a:Description>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 Sistem mora garantovati da jedan vremenski termin moze imati samo jednu aktivnu rezervaciju ,\&#39;e8ime se elemini\&#39;9au konflikti u rasporedu servisa. \f1\par
}
</a:Description>
<c:AttachedRequirements>
<o:Shortcut Ref="o78"/>
</c:AttachedRequirements>
</o:UseCase>
<o:UseCase Id="o161">
<a:ObjectID>11C39835-F7F5-4DC8-B01D-DAFC07EBD368</a:ObjectID>
<a:Name>Prikaz slobodnih termina</a:Name>
<a:Code>UC-05</a:Code>
<a:CreationDate>1789495901</a:CreationDate>
<a:Creator>nikol</a:Creator>
<a:ModificationDate>1789495901</a:ModificationDate>
<a:Modifier>nikol</a:Modifier>
<a:GlobalObjectID/>
<a:Step>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.Korisnik odabira tip servisa i \&#39;9eeljeni datum.\par
2.Sistem dohvata sve postoje\&#39;e6e rezervacije za taj dan.\par
3.sistem uzima u obzir radno vrijeme i trajanje usluge.\par
4.Sistem prikazuje slobodne vremenske slotove.\f1\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.Nema slobodnih terima, poruka sa prijedlogom sljede\&#39;e6eg slobodnog dana.\par
2. Servis ne radi taj dan , odgovaraju\&#39;e6e obaje\&#39;9atenje se \&#39;9aalje korisniku.\par
\f1\par
}
</a:UseCase.Extension>
<a:PreCondition>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.\f1 Korisnik je prijavljen u sistem.\par
\f0 2.\f1 Korisnik je odabrao tip servisa koji \f0\&#39;9e\f1 eli zakazati.\par
\f0 3.\f1 Sistem ima definisan radni raspored i radno vrijeme.\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 Korisnik vidi listu slobodnih termina i mo\&#39;9ee odabrati odgovaraju\&#39;e6i.\f1\par
}
</a:PostCondition>
<a:Description>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 Sistem mora prikazati korisniku listu slobodnih termina na osnovu odabranog tipa servisa i \&#39;9eeljenog datuma , uzimaju\&#39;e6i u obzir procijenjeno trajanje svake usluge. \f1\par
}
</a:Description>
<c:AttachedRequirements>
<o:Shortcut Ref="o77"/>
</c:AttachedRequirements>
</o:UseCase>
<o:UseCase Id="o160">
<a:ObjectID>C1BE9261-575C-4C66-8758-EA3E82D7A6CA</a:ObjectID>
<a:Name>Rezervacija termina</a:Name>
<a:Code>UC-04</a:Code>
<a:CreationDate>1789495901</a:CreationDate>
<a:Creator>nikol</a:Creator>
<a:ModificationDate>1789495901</a:ModificationDate>
<a:Modifier>nikol</a:Modifier>
<a:GlobalObjectID/>
<a:Step>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.Korisnik odabira vozilo i tip servisa.\par
2.sistem prikazuje slobodne termine (FR-05).\par
3.Korisnik odabira \&#39;9eeljeni datum i sat.\par
4.sistem provjerava dostupnost termina (FR-06)\par
5.Rezervacija se kreira sa statusom PENDING\par
6.Korisnik prima potvrdu rezervacije.\par
\f1\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1.Termin nije dostupan , prikazuju se alternativni slobodni termini.\par
2. Korisnik nema vozila . preusmjeravanje na dodavanje vozila (FR-03).\par
\f1\par
}
</a:UseCase.Extension>
<a:PreCondition>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 1. Korisnik je prijavljen u sistem (FR-02)\f1 .\f0\par
2. Korisnik ima najmanje jedno registrovano vozilo (FR-03)\f1 .\f0\par
3. Sistem ima definisane slobodne termine u kalendaru (FR-05)\f1 .\f0\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 Termin servisa je rezervisan i vidljiv korisniku u pregledu rezervacija.\par
\f1\par
}
</a:PostCondition>
<a:Description>{\rtf1\ansi\ansicpg1250\deff0\nouicompat\deflang6170{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs16 Sistem mora omogu\&#39;e6iti korisniku zakazivanje servisnog termina odabirom vozila ,tipa servisa i slobodnog termina iz kalendara.\f1\par
}
</a:Description>
<c:AttachedRequirements>
<o:Shortcut Ref="o76"/>
</c:AttachedRequirements>
</o:UseCase>
